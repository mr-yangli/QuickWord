<Project>

  <!-- 由原 QuickNet 单仓拆出为独立仓：作者/许可/仓库地址内联自原根 Directory.Build.props，
       仓库地址指向本家独立仓（GitHub: mr-yangli）。 -->
  <PropertyGroup>
    <Authors>YANGLI</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mr-yangli/QuickWord</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/mr-yangli/QuickWord.git</RepositoryUrl>
  </PropertyGroup>
  <!-- word/ 子树闸门。与 sql/ 同形状的公共设置；刻意不带 sql 的
       TreatWarningsAsErrors + trim/AOT 分析器（理由见 excel/Directory.Build.props 头注）。 -->
  <PropertyGroup>
    <!-- 多目标 net10.0 + net11.0（2026-11-11，随 QuickJob 10.1.0 的先例）：单包双资产，
         消费方按宿主 TFM 自动还原；tests / samples 一并继承双档。 -->
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- NuGet 打包元数据里本仓独有的那三颗：版本号、README 挂哪一份册子、Tags 说什么。作者与许可内联在本文件上面那段。
       版本口径（跟 .NET 主版本走、10.0.0 起发稳定档、重打必升一颗）见 excel/Directory.Build.props 那段注释，五族共用一份。 -->
  <PropertyGroup>
    <!-- 10.1.0：新增多目标 net10.0+net11.0 属新增（非破坏），按家规升次版本号。 -->
    <Version>10.1.0</Version>
    <PackageReadmeFile>quickword-usage.md</PackageReadmeFile>
    <PackageTags>word;docx;table;export</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)docs/quickword-usage.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
