<Project>

  <!-- 由原 QuickNet 单仓拆出为独立仓：作者/许可/仓库地址内联自原根 Directory.Build.props，
       仓库地址指向本家独立仓（GitHub: mr-yangli）。 -->
  <PropertyGroup>
    <Authors>YANGLI</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mr-yangli/QuickWord</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/mr-yangli/QuickWord.git</RepositoryUrl>
  </PropertyGroup>
  <!-- word/ 子树闸门。与 sql/ 同形状的公共设置；刻意不带 sql 的
       TreatWarningsAsErrors + trim/AOT 分析器（理由见 excel/Directory.Build.props 头注）。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- NuGet 打包元数据里本子树独有的那三颗。版本从 0.1.0-beta.1 起，理由见 excel/Directory.Build.props
       那一段注释。 -->
  <PropertyGroup>
    <Version>10.0.0</Version>
    <PackageReadmeFile>quickword-usage.md</PackageReadmeFile>
    <PackageTags>word;docx;table;export</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)docs/quickword-usage.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
